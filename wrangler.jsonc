{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "finci",
	"compatibility_date": "2026-10-13",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./worker.ts",
	"routes": [
		{
			"pattern": "finci.web.id",
			"custom_domain": true
		}
	],
	"vars": {
		"BETTER_AUTH_URL": "https://finci.web.id"
	},
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "finci",
			"database_id": "dd7bc7c6-3a02-4b3a-a4d6-dbcba50af230"
		}
	]
}
